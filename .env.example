# Leave everything unset for the default: records live in the browser's
# IndexedDB and never leave the device. That is a complete, working setup.

# Point the frontend at the sync server in /server to also push records there.
# Use the machine's LAN IP, not localhost, if you are testing from a phone.
# VITE_API_BASE="http://192.168.1.20:8787"

# Server-side only (read by server/index.js, not by the browser):
# PORT=8787
# DATA_DIR="./server/data"
# CORS_ORIGIN="http://192.168.1.20:3000"
